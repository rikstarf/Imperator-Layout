# Imperator transparency preset: solid. Opacity only; the color always comes from the theme. The top panel (stock, macOS layout) is set by imperator-dock-theme.
[org/gnome/shell/extensions/dash-to-panel]
trans-use-custom-opacity=true
trans-panel-opacity=1.0

[org/gnome/shell/extensions/dash-to-dock]
transparency-mode='FIXED'
background-opacity=1.0

[org/gnome/shell/extensions/imperator-dock-theme]
panel-opacity=1.0
