# Imperator glass: backdrop blur on the dock/taskbar, popups (quick settings, menus, calendar), the overview and every window;
# a see-through top bar with white text comes from imperator-dock-theme (glass=true). Blur My Shell itself is enabled by the
# imperator-layout script. Everything not listed keeps Blur My Shell's own defaults. Per-layout differences: glass-<layout>.dconf.
#
# Glass is part of the macos layout only (imperator-layout enforces it); this file is loaded for that layout.
# Look: follows the system color scheme. Every component runs in BMS's automatic pipeline mode: light scheme = blur + 50% white,
# dark scheme = blur + darkening. The dock and popups use the transparent style: the pipeline alone tints them (no extra white fill).
# Application windows get their own, stronger blur (the imperator_window_* pipelines below).
[org/gnome/shell/extensions/imperator-dock-theme]
glass=true

# The dock and taskbar background must not be opaque, or there is nothing to blur through: glass owns their opacity while on.
[org/gnome/shell/extensions/dash-to-dock]
transparency-mode='FIXED'
background-opacity=0.0

[org/gnome/shell/extensions/dash-to-panel]
trans-use-custom-opacity=true
trans-panel-opacity=0.0

# Pipelines: aimed at the macOS Tahoe look (very wide, smeared blur that keeps the wallpaper's colors, pale veil in light mode):
# imperator_glass_* (radius 150) for the dock, top bar, popups and overview; imperator_window_* (radius 200, the maximum) for windows.
# The two stock pipelines stay for reference.
[org/gnome/shell/extensions/blur-my-shell]
pipelines={'pipeline_default': {'name': <'Default'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_000000000000'>, 'params': <{'unscaled_radius': <30>, 'brightness': <0.6>}>}>]>}, 'pipeline_default_light': {'name': <'Default (Light mode)'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_default_light_blur'>, 'params': <{'unscaled_radius': <30>, 'brightness': <1>}>}>, <{'type': <'color'>, 'id': <'effect_default_light_color'>, 'params': <{'color': <(1.0, 1.0, 1.0, 0.5)>, 'blend_mode': <3>}>}>]>}, 'imperator_glass_light': {'name': <'Imperator glass (light)'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_ig_light_blur'>, 'params': <{'unscaled_radius': <150>, 'brightness': <1>}>}>, <{'type': <'luminosity'>, 'id': <'effect_ig_light_sat'>, 'params': <{'saturation_multiplicator': <1.35>}>}>, <{'type': <'color'>, 'id': <'effect_ig_light_color'>, 'params': <{'color': <(1.0, 1.0, 1.0, 0.25)>, 'blend_mode': <3>}>}>]>}, 'imperator_glass_dark': {'name': <'Imperator glass (dark)'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_ig_dark_blur'>, 'params': <{'unscaled_radius': <150>, 'brightness': <0.75>}>}>, <{'type': <'luminosity'>, 'id': <'effect_ig_dark_sat'>, 'params': <{'saturation_multiplicator': <1.3>}>}>]>}, 'imperator_window_light': {'name': <'Imperator window (light)'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_iw_light_blur'>, 'params': <{'unscaled_radius': <200>, 'brightness': <1>}>}>, <{'type': <'luminosity'>, 'id': <'effect_iw_light_sat'>, 'params': <{'saturation_multiplicator': <1.4>}>}>, <{'type': <'color'>, 'id': <'effect_iw_light_color'>, 'params': <{'color': <(1.0, 1.0, 1.0, 0.25)>, 'blend_mode': <3>}>}>]>}, 'imperator_window_dark': {'name': <'Imperator window (dark)'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_iw_dark_blur'>, 'params': <{'unscaled_radius': <200>, 'brightness': <0.7>}>}>, <{'type': <'luminosity'>, 'id': <'effect_iw_dark_sat'>, 'params': <{'saturation_multiplicator': <1.3>}>}>]>}}

[org/gnome/shell/extensions/blur-my-shell/panel]
pipeline-light='imperator_glass_light'
pipeline-dark='imperator_glass_dark'
blur=true
pipeline-auto-mode=true

[org/gnome/shell/extensions/blur-my-shell/dash-to-dock]
pipeline-light='imperator_glass_light'
pipeline-dark='imperator_glass_dark'
blur=true
static-blur=false
pipeline-auto-mode=true
style-dash-to-dock=0

[org/gnome/shell/extensions/blur-my-shell/overview]
pipeline-light='imperator_glass_light'
pipeline-dark='imperator_glass_dark'
blur=true
pipeline-auto-mode=true

[org/gnome/shell/extensions/blur-my-shell/appfolder]
pipeline-light='imperator_glass_light'
pipeline-dark='imperator_glass_dark'
pipeline-auto-mode=true

[org/gnome/shell/extensions/blur-my-shell/popup]
pipeline-light='imperator_glass_light'
pipeline-dark='imperator_glass_dark'
blur=true
pipeline-auto-mode=true
style-popup=0
# Blur My Shell paints a solid theme fill on popups it does not blur (the control panel) and tints the rest; imperator-dock-theme's
# glass.css owns popup backgrounds and text instead.
override-background=false
# The quick settings panel (control panel) gets the dock's look WITHOUT blur: see glass.css.
blur-quick-settings=false
blur-submenus=false

# Every application window: blurred backdrop (stronger pipeline than the dock's), window made translucent so it shows through.
# opacity is the window actor's alpha (0-255) and would fade the text and icons too, so it stays 255. The translucent backgrounds
# come from the GTK CSS the script installs (layouts/glass-gtk4.css, glass-gtk3.css).
[org/gnome/shell/extensions/blur-my-shell/applications]
blur=true
enable-all=true
# Static blur: the blurred wallpaper under each window. The live (dynamic) blur did not show on windows in the first VM look.
static-blur=true
pipeline-auto-mode=true
pipeline-light='imperator_window_light'
pipeline-dark='imperator_window_dark'
dynamic-opacity=false
blur-menus=true
blur-on-overview=true
opacity=255

[org/gnome/shell/extensions/blur-my-shell/lockscreen]
blur=false

[org/gnome/shell/extensions/blur-my-shell/screenshot]
blur=false
