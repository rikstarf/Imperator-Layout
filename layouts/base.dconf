# Imperator desktop base profile (shared by all layouts)
[org/gnome/desktop/interface]
enable-hot-corners=false

[org/gnome/shell/extensions/dash-to-panel]
# Imperator pins these where they differ from the upstream defaults (panel margins and corner radius included).
activate-single-window=true
click-action='CYCLE-MIN'
dot-style-focused='CILIORA'
dot-style-unfocused='DOTS'
global-border-radius=3
group-apps=true
group-apps-use-fixed-width=false
group-apps-use-launchers=false
hot-keys=true
intellihide=false
intellihide-hide-from-windows=true
multi-monitors=false
panel-anchors='{}'
panel-element-positions-monitors-sync=true
panel-lengths='{}'
panel-side-margins=4
panel-top-bottom-margins=4
panel-positions='{}'
panel-sizes='{}'
peek-mode=true
shortcut-num-keys='NUM_ROW'
show-favorites=true
show-favorites-all-monitors=true
show-running-apps=true
show-tooltip=true
show-window-previews=true
stockgs-keep-top-panel=false
window-preview-size=200

[org/gnome/shell/extensions/dash-to-dock]
apply-custom-theme=false
click-action='focus-minimize-or-previews'
custom-theme-shrink=false
dock-fixed=false
dock-position='BOTTOM'
extend-height=false
hot-keys=true
icon-size-fixed=false
show-apps-always-in-the-edge=false
show-apps-at-top=true
show-favorites=true
show-mounts=false
show-mounts-network=false
show-mounts-only-mounted=false
show-show-apps-button=true
show-trash=true
transparency-mode='DEFAULT'
# pinned: the upstream defaults differ
running-indicator-style='DOTS'
application-counter-overrides-notifications=false

# Light top bar is a macOS-layout choice; every layout sets it so switching layouts never leaves it on.
[org/gnome/shell/extensions/imperator-dock-theme]
light-panel=false
